def make_price_fig(
    gold: pd.DataFrame, 
    btc: pd.DataFrame, 
    yaxis_type: str = "Linear",
    visible_events: list = [] 
) -> go.Figure:
    """Creates the dual-axis Price/Growth figure."""
    
    joined = gold.join(btc, how="inner").dropna()
    if joined.empty:
        return go.Figure().update_layout(title="No overlapping Gold/BTC data")
        
    fig = make_subplots(specs=[[{"secondary_y": True}]])
    
    fig.add_trace(
        go.Scatter(
            x=joined.index, y=joined["Gold"],
            name="Gold (USD / oz)",
            mode="lines",
            line=dict(width=2, color="gold"),
            hovertemplate="<br>".join([
                "<b>Date: %{x|%b %Y}</b>",
                "Gold (USD / oz): $%{y:.2f}",
                "<extra></extra>"
            ])
        ),
        secondary_y=False
    )
    
    fig.add_trace(
        go.Scatter(
            x=joined.index, y=joined["BTC"],
            name="Bitcoin (USD / BTC)",
            mode="lines",
            line=dict(width=2, color="navy"),
            hovertemplate="<br>".join([
                "<b>Date: %{x|%b %Y}</b>",
                "Bitcoin (USD / BTC): $%{y:.2f}",
                "<extra></extra>"
            ])
        ),
        secondary_y=True
    )

    # --- Axis Configuration ---
    axis_type_str = "log" if yaxis_type == "Log" else "linear"
    log_dtick = 1 if axis_type_str == "log" else None
    
    # Calculate padded ranges using the helper function
    y1_range, y2_range = _calculate_plot_ranges(joined["Gold"], joined["BTC"], axis_type_str)
    
    # --- Layout & Styling ---
    fig.update_layout(
        title="Gold & Bitcoin Growth",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=24) 
        ),
        plot_bgcolor='white',
    )

    fig.update_xaxes(
        title_text="Date", 
        title_font=dict(size=22), 
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=20) 
    )
    
    fig.update_yaxes(
        title_text="Gold (USD / oz)", 
        title_font=dict(size=26, color="gold"), 
        secondary_y=False, 
        showgrid=False,
        linecolor='black',
        mirror=True,
        type=axis_type_str,
        dtick=log_dtick,
        tickfont=dict(size=22), 
        showticklabels=True,
        range=y1_range 
    )
    
    fig.update_yaxes(
        title_text="Bitcoin (USD / BTC)", 
        title_font=dict(size=26, color="navy"), 
        secondary_y=True, 
        showgrid=False,
        linecolor='black',
        mirror=True,
        type=axis_type_str,
        dtick=log_dtick,
        tickfont=dict(size=22), 
        showticklabels=True,
        range=y2_range 
    )
    
    # --- Add Event Annotations ---
    for event_name in visible_events:
        if event_name in EVENTS_TO_PLOT:
            event_date = EVENTS_TO_PLOT[event_name]
            try:
                fig.add_vline(
                    x=pd.to_datetime(event_date),
                    line_width=1,
                    line_dash="dot",
                    line_color="black"
                )
                fig.add_annotation(
                    x=pd.to_datetime(event_date),
                    y=0.95, 
                    yref="paper",
                    text=event_name,
                    showarrow=False,
                    font=dict(size=18, color="black"), 
                    bgcolor="rgba(255, 255, 255, 0.7)",
                    bordercolor="black",
                    borderwidth=1,
                    xanchor="center",
                    yanchor="bottom"
                )
            except Exception as e:
                print(f"Could not plot event '{event_name}' at '{event_date}': {e}")
                
    return fig

def make_corr_fig(gold: pd.DataFrame, btc: pd.DataFrame, sp: pd.DataFrame, window: int) -> go.Figure:
    """Creates the rolling correlation figure."""
    
    # Calculate returns using the helper function
    ret = _calculate_returns(gold, btc, sp)
    
    if ret.empty:
        return go.Figure().update_layout(title="No overlapping data for correlations")

    # Calculate rolling correlations
    corr_gold_sp = ret["Gold"].rolling(window).corr(ret["SP"])
    corr_btc_sp = ret["BTC"].rolling(window).corr(ret["SP"])

    fig = go.Figure()
    
    fig.add_trace(go.Scatter(
        x=corr_gold_sp.index, y=corr_gold_sp, 
        mode="lines",
        name=f"{window}-Day Gold vs S&P",
        line=dict(width=2, color="gold"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "Gold vs S&P Corr: %{y:.2f}",
            "<extra></extra>"
        ])
    ))
    
    fig.add_trace(go.Scatter(
        x=corr_btc_sp.index, y=corr_btc_sp, 
        mode="lines",
        name=f"{window}-Day BTC vs S&P",
        line=dict(width=2, color="navy"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "BTC vs S&P Corr: %{y:.2f}",
            "<extra></extra>"
        ])
    ))

    fig.add_hline(y=0, line_dash="dot", line_color="black")

    fig.update_layout(
        title=f"Rolling Correlations vs S&P 500",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        yaxis=dict(range=[-1, 1]),
        plot_bgcolor='white',
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=24)
        )
    )
    
    fig.update_xaxes(
        title_text="Date", 
        title_font=dict(size=22),
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=20)
    )
    
    fig.update_yaxes(
        title_text="Correlation (ρ)", 
        title_font=dict(size=24), 
        showgrid=False,
        linecolor='black',
        mirror=True,
        tickfont=dict(size=20)
    )
    
    return fig

def make_vol_fig(gold: pd.DataFrame, btc: pd.DataFrame, window: int) -> go.Figure:
    """Creates the rolling volatility figure."""
    
    ret = _calculate_returns(gold, btc)
    
    if ret.empty:
        return go.Figure().update_layout(title="No overlapping data for Volatility")

    # Calculate rolling annualised volatility
    # (std of daily returns * sqrt(trading days per year))
    TRADING_DAYS_PER_YEAR = 252
    vol_gold = ret["Gold"].rolling(window).std() * np.sqrt(TRADING_DAYS_PER_YEAR)
    vol_btc = ret["BTC"].rolling(window).std() * np.sqrt(TRADING_DAYS_PER_YEAR)

    fig = go.Figure()
    
    fig.add_trace(go.Scatter(
        x=vol_gold.index, y=vol_gold, 
        mode="lines",
        name=f"{window}-Day Volatility (Gold)",
        line=dict(width=2, color="gold"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "Gold Volatility: %{y:.2%}", 
            "<extra></extra>"
        ])
    ))
    
    fig.add_trace(go.Scatter(
        x=vol_btc.index, y=vol_btc, 
        mode="lines",
        name=f"{window}-Day Volatility (BTC)",
        line=dict(width=2, color="navy"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "BTC Volatility: %{y:.2%}", 
            "<extra></extra>"
        ])
    ))

    fig.update_layout(
        title=f"{window}-Day Rolling Volatility (Annualised)",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        yaxis=dict(tickformat=".0%"), # Format y-axis as percentage
        plot_bgcolor='white',
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=24)
        )
    )
    
    fig.update_xaxes(
        title_text="Date", 
        title_font=dict(size=22), 
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=20)
    )
    
    fig.update_yaxes(
        title_text="Volatility (Annualised)", 
        title_font=dict(size=24), 
        showgrid=False,
        linecolor='black',
        mirror=True,
        tickfont=dict(size=20)
    )
    
    return fig

