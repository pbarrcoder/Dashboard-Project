def _clean_num(series: pd.Series) -> pd.Series:
    """Cleans a pandas Series to ensure it's a numeric float type."""
    series_str = series.astype(str)
    
    # Remove common non-numeric characters
    cleaned_str = (
        series_str.str.replace('"', '', regex=False)
        .str.replace("'", "", regex=False)
        .str.replace(",", "", regex=False)
        .str.replace("\u2212", "-", regex=False)  # \u2212 is a "minus" symbol
        .str.strip()
    )
    
    # Replace empty strings or "None" text with NumPy's "Not a Number"
    final_series = cleaned_str.replace({"": np.nan, "None": np.nan})
    
    return final_series.astype(float)

def _find_date_col(df: pd.DataFrame) -> str:
    """Finds the most likely 'Date' column in a DataFrame."""
    for c in df.columns:
        lc = c.strip().lower()
        if lc in ("date", "time", "day") or "date" in lc:
            return c
    raise ValueError("No date column found.")

def _find_close_col(df: pd.DataFrame) -> str:
    """Finds the most likely 'Price' or 'Close' column in a DataFrame."""
    candidates = ["Close", "Adj Close", "Close*", "Price", "Last", "Close/Last"]
    for c in df.columns:
        if c.strip() in candidates or c.strip().lower() in [x.lower() for x in candidates]:
            return c
            
    # Fallback: find the first numeric-like column that isn't the date
    for c in df.columns:
        if c.lower() != "date":
            try:
                pd.to_numeric(df[c].astype(str).str.replace(",", ""), errors="raise")
                return c
            except Exception:
                pass
                
    raise ValueError("No price/close column found.")

def load_series(path: str, label: str) -> pd.DataFrame:
    """Loads a CSV file, cleans it, and formats it into a time series DataFrame."""
    
    if not os.path.exists(path):
        print(f"WARNING: File not found at {path}. Returning empty DataFrame for {label}.")
        return pd.DataFrame(columns=[label]).set_index(pd.to_datetime([])) 
        
    df = pd.read_csv(path)
    df.columns = [c.strip() for c in df.columns]
    
    # Find the critical date and price columns
    date_col = _find_date_col(df)
    price_col = _find_close_col(df)
    
    # Standardize and clean the data
    df["Date"] = pd.to_datetime(df[date_col].astype(str).str.strip(), errors="coerce")
    df[label] = _clean_num(df[price_col])
    
    # Filter, sort, and set the index
    df = df[["Date", label]].dropna().sort_values("Date")
    df = df[df["Date"] >= START_DATE].set_index("Date")
    
    return df

def _calculate_returns(*assets: pd.DataFrame) -> pd.DataFrame:
    """Takes multiple asset DataFrames and returns a joined DataFrame of daily returns."""
    returns = []
    for df in assets:
        # Assumes the first (and only) column is the one of interest
        col_name = df.columns[0] 
        ret = df[col_name].pct_change().rename(col_name)
        returns.append(ret)
    
    # Combine all series into one DataFrame and drop days where not all assets have data
    return pd.concat(returns, axis=1).dropna()

def _calculate_plot_ranges(
    y1_data: pd.Series, y2_data: pd.Series, axis_type: str
) -> (list, list):
    """Calculates padded Y-axis ranges for both linear and log scales."""
    
    y1_min, y1_max = y1_data.min(), y1_data.max()
    y2_min, y2_max = y2_data.min(), y2_data.max()

    if axis_type == "log":
        # For log scales, pad by a multiplier and ensure no 0 or negative values
        y1_range = [
            math.log10(max(y1_min * 0.95, 1)),  # Use 1 as the floor
            math.log10(y1_max * 1.05)
        ]
        y2_range = [
            math.log10(max(y2_min * 0.95, 1)),
            math.log10(y2_max * 1.05)
        ]
    else:
        # For linear scales, add a 5% padding
        y1_pad = (y1_max - y1_min) * 0.05
        y2_pad = (y2_max - y2_min) * 0.05
        y1_range = [y1_min - y1_pad, y1_max + y1_pad]
        y2_range = [y2_min - y2_pad, y2_max + y2_pad]
        
    return y1_range, y2_range

