# --- Helper function (used by both) ---
def clean_numeric_series(s: pd.Series) -> pd.Series:
    return (
        s.astype(str)
         .str.replace('"', '', regex=False)
         .str.replace("'", "", regex=False)
         .str.replace(",", "", regex=False)
         .str.replace("$", "", regex=False)
         .str.replace("%", "", regex=False)
         .str.strip()
         .replace("", pd.NA)
         .astype(float)
    )

# --- Graph 1 (Growth) Data Functions ---

def load_and_clean_for_growth(filename, asset_name):
    """Loads a CSV for the growth chart, sets Date as index, and filters by START_DATE."""
    if not filename.exists():
        raise FileNotFoundError(
            f"ERROR: File not found: '{filename}'. "
            f"Please ensure the path and filename is correct."
        )

    df = pd.read_csv(filename, skip_blank_lines=True)
    df.columns = [c.strip() for c in df.columns]

    date_col = next((c for c in df.columns if c.strip().lower() in ["date", "day", "time"]), None)
    if date_col is None:
        raise ValueError(f"No 'Date' column found in {filename}")
        
    close_col = next(
        (c for c in df.columns for cand in CLOSE_CANDIDATES if c.strip().lower() == cand.strip().lower()), 
        None
    )
    if close_col is None:
        raise ValueError(f"No closing price column found (e.g., Close, Price) in {filename}")
        
    df["Date"] = pd.to_datetime(
        df[date_col].astype(str).str.replace('"', '').str.strip(), 
        errors='coerce'
    )

    df["Close"] = clean_numeric_series(df[close_col])
    
    df = df[["Date", "Close"]].dropna(subset=["Date", "Close"]).sort_values("Date")
    df = df.set_index("Date") # Set Date as index
    df = df[df.index >= START_DATE] # Filter by start date
    
    return df.rename(columns={'Close': f'Close_{asset_name}'})

def prepare_growth_data():
    """Prepares the merged Gold/BTC dataframe for the growth chart."""
    try:
        gold_df = load_and_clean_for_growth(GOLD_FILE, 'Gold')
        btc_df  = load_and_clean_for_growth(BTC_FILE, 'BTC')
    except Exception as e:
        print(f"ERROR loading files for growth chart: {e}")
        return pd.DataFrame() # Return empty

    # Merge
    combined = pd.merge(gold_df[[f'Close_Gold']], 
                        btc_df[[f'Close_BTC']], 
                        left_index=True, right_index=True, how="inner").dropna()
    
    if combined.empty:
        print(f"ERROR: No common dates found for growth chart after {START_DATE}.")
        # --- FIX: Stop the app if data is empty ---
        sys.exit("Exiting: Growth data is empty. Check your CSV files and START_DATE.")
    
    return combined

# --- Graph 2 (Correlation) Data Functions ---

def load_and_clean_for_corr(filepath: Path, ticker_label: str) -> pd.DataFrame:
    """Loads a CSV for the correlation chart, keeping 'Date' as a column."""
    if not filepath.exists():
        raise FileNotFoundError(f"File not found: {filepath} (checked {filepath.resolve()})")
    df = pd.read_csv(filepath, skip_blank_lines=True)
    df.columns = [c.strip() for c in df.columns]

    date_col = next((c for c in df.columns if c.strip().lower() in ("date", "day", "time")), None)
    if date_col is None:
        date_col = next((c for c in df.columns if "date" in c.lower()), None)
    if date_col is None:
        raise ValueError(f"No date column found in {filepath.name}")

    df["Date"] = pd.to_datetime(df[date_col].astype(str).str.replace('"','').str.strip(), errors='coerce')
    df = df.rename(columns={date_col: "Date"})

    close_col = None
    for c in df.columns:
        for cand in CLOSE_CANDIDATES:
            if c.strip().lower() == cand.strip().lower():
                close_col = c
                break
        if close_col:
            break
    if close_col is None:
        raise ValueError(f"No price-like column found in {filepath.name}")

    df["Close"] = clean_numeric_series(df[close_col])
    df = df[["Date", "Close"]].dropna(subset=["Date", "Close"]).sort_values("Date").reset_index(drop=True)
    return df.rename(columns={"Close": f"Close_{ticker_label}"})

def prepare_correlation_data():
    """Prepares the merged S&P/BTC/Gold dataframe for the correlation chart."""
    try:
        btc = load_and_clean_for_corr(BTC_FILE, "BTC")
        sp  = load_and_clean_for_corr(SP_FILE, "SP")
        gold = load_and_clean_for_corr(GOLD_FILE, "GOLD")
    except Exception as e:
        print(f"ERROR loading files: {e}")
        sys.exit(1)

    combined = sp.merge(btc, on="Date", how="inner").merge(gold, on="Date", how="inner")
    if combined.empty:
        print("No overlapping dates across files. Exiting.")
        sys.exit(1)

    # --- THIS IS THE FIX ---
    combined = combined.sort_values("Date").reset_index(drop=True)
    # --- END OF FIX ---
    
    combined["SP_Change"]   = combined["Close_SP"].pct_change()
    combined["BTC_Change"]  = combined["Close_BTC"].pct_change()
    combined["GOLD_Change"] = combined["Close_GOLD"].pct_change()
    combined = combined.dropna(subset=["SP_Change", "BTC_Change", "GOLD_Change"]).reset_index(drop=True)

    if combined.empty:
        print("Not enough data after computing percent changes. Exiting.")
        sys.exit(1)

    try:
        last = combined["Date"].max()
        start = last - pd.DateOffset(years=LOOKBACK_YEARS)
        combined = combined[combined["Date"] >= start].reset_index(drop=True)
    except Exception:
        pass

    return combined

def precompute_cumsums(x: np.ndarray, y: np.ndarray):
    x = x.astype(float)
    y = y.astype(float)
    xy = x * y
    x2 = x * x
    y2 = y * y
    cX  = np.concatenate(([0.0], np.cumsum(x)))
    cY  = np.concatenate(([0.0], np.cumsum(y)))
    cXY = np.concatenate(([0.0], np.cumsum(xy)))
    cX2 = np.concatenate(([0.0], np.cumsum(x2)))
    cY2 = np.concatenate(([0.0], np.cumsum(y2)))
    return cX, cY, cXY, cX2, cY2

def rolling_corr_from_cumsums(cX, cY, cXY, cX2, cY2, window):
    n = len(cX) - 1
    if window <= 1:
        return np.full(n, np.nan)
    idx_end = np.arange(window, n+1)
    idx_start = idx_end - window
    sum_x = cX[idx_end] - cX[idx_start]
    sum_y = cY[idx_end] - cY[idx_start]
    sum_xy = cXY[idx_end] - cXY[idx_start]
    sum_x2 = cX2[idx_end] - cX2[idx_start]
    sum_y2 = cY2[idx_end] - cY2[idx_start]
    mean_x = sum_x / window
    mean_y = sum_y / window
    cov = (sum_xy / window) - (mean_x * mean_y)
    var_x = (sum_x2 / window) - (mean_x * mean_x)
    var_y = (sum_y2 / window) - (mean_y * mean_y)
    var_x = np.where(var_x < 0, 0.0, var_x)
    var_y = np.where(var_y < 0, 0.0, var_y)
    denom = np.sqrt(var_x * var_y)
    with np.errstate(divide='ignore', invalid='ignore'):
        rho = cov / denom
    result = np.full(n, np.nan)
    result[window-1:] = rho
    return result

