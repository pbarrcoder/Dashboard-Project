@dashboard.callback(
    Output('growth-graph', 'figure'),
    Input('scale-toggle', 'value')
)
def update_growth_graph(scale_value):
    # Create figure with secondary y-axis
    fig = make_subplots(specs=[[{"secondary_y": True}]])
    
    GOLD_COLOR = "#E69F00"
    BTC_COLOR = "#003366"
    
    # Add Gold trace (using full growth_data)
    fig.add_trace(
        go.Scatter(
            x=growth_data.index, 
            y=growth_data['Close_Gold'], 
            name="Gold Price (USD per oz)",
            line=dict(color=GOLD_COLOR, width=2.5)
        ),
        secondary_y=False,
    )
    
    # Add BTC trace (using full growth_data)
    fig.add_trace(
        go.Scatter(
            x=growth_data.index, 
            y=growth_data['Close_BTC'], 
            name="Bitcoin Price (USD per BTC)",
            line=dict(color=BTC_COLOR, width=2.5)
        ),
        secondary_y=True,
    )

    # Set y-axes titles
    fig.update_yaxes(
        title_text="<b>Gold Price</b> (USD per oz)", 
        secondary_y=False, 
        type=scale_value, 
        color=GOLD_COLOR,
        gridcolor='#eeeeee'
    )
    fig.update_yaxes(
        title_text="<b>Bitcoin Price</b> (USD per BTC)", 
        secondary_y=True, 
        type=scale_value, 
        color=BTC_COLOR,
        showgrid=False # Only show grid for one y-axis
    )

    # Set layout
    fig.update_layout(
        title_text=f"Gold Vs Bitcoin Growth ({scale_value.capitalize()} Scale)",
        title_x=0.5,
        xaxis_title="Date",
        legend=dict(yanchor="top", y=0.99, xanchor="left", x=0.01, bgcolor='rgba(255,255,255,0.7)'),
        transition_duration=200,
        paper_bgcolor='white',
        plot_bgcolor='white'
    )
    
    return fig

# --- Callback for Graph 2 (Correlation) ---
# --- UPDATED TO USE '@dashboard.callback' ---
@dashboard.callback(
    [Output('correlation-graph', 'figure'),
     Output('slider-output-display', 'children')],
    [Input('window-slider', 'value')]
)
def update_correlation_graph(window_value):
    w = int(window_value)
    
    rho_btc = rolling_corr_from_cumsums(cX_btc, cY_sp_b, cXY_btc_sp, cX2_btc, cY2_sp_b, w)
    rho_gold = rolling_corr_from_cumsums(cX_gold, cY_sp_g, cXY_gold_sp, cX2_gold, cY2_sp_g, w)
    
    fig = go.Figure()
    
    BTC_COLOR = "#003366"
    GOLD_COLOR = "#E69F00"
    
    fig.add_trace(go.Scatter(
        x=corr_dates, 
        y=rho_btc, 
        name=f"{w}-Day BTC vs S&P", 
        line=dict(color=BTC_COLOR, width=2.5)
    ))
    
    fig.add_trace(go.Scatter(
        x=corr_dates, 
        y=rho_gold, 
        name=f"{w}-Day Gold vs S&P", 
        line=dict(color=GOLD_COLOR, width=2.5)
    ))
    
    fig.add_hline(y=0.0, line_width=1, line_dash="dash", line_color="black")
    
    fig.update_layout(
        title_text=f"{w}-Day Rolling Correlations — BTC & Gold vs S&P 500",
        title_x=0.5,
        yaxis_title="Correlation (ρ)",
        yaxis_range=[-1, 1],
        xaxis_title="Date",
        legend=dict(yanchor="top", y=0.99, xanchor="left", x=0.01, bgcolor='rgba(255,255,255,0.7)'),
        transition_duration=200,
        paper_bgcolor='white',
        plot_bgcolor='white',
        yaxis_gridcolor='#eeeeee'
    )
    
    return fig, f"Current Window: {w} days"

