# a4_dashboard.py
# One-page (A4 portrait) mini dashboard with two graphs:
# 1) "Gold Vs Bitcoin Growth" (dual y-axes, legend below, Gold=gold, BTC=navy, larger y-axis labels)
# 2) Rolling correlation (BTC vs S&P) and (Gold vs S&P) with a slider
