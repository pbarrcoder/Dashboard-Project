                    )
                ]),
                dcc.Graph(
                    id="fig-corr",
                    figure=make_corr_fig(gold, btc, sp, ROLL_DAYS), 
                    config={"displayModeBar": False},
                    style={"height": "120mm"}
                )
            ])
        ])
