EVENTS_TO_PLOT = {
    "Crypto Capitulation": "2018-11-14",
    "COVID-19 Black Thursday": "2020-03-20",
    "Russia invades Ukraine": "2022-02-24",
    "Trump Liberation Day": "2025-04-02"
}

def _clean_num(s: pd.Series) -> pd.Series:
    return (
        s.astype(str)
        .str.replace('"', '', regex=False)
        .str.replace("'", "", regex=False)
        .str.replace(",", "", regex=False)
        .str.replace("\u2212", "-", regex=False)  
        .str.strip()
        .replace({"": np.nan, "None": np.nan})
        .astype(float)
    )

def _find_date_col(df: pd.DataFrame) -> str:
    for c in df.columns:
        lc = c.strip().lower()
        if lc in ("date", "time", "day") or "date" in lc:
            return c
    raise ValueError("No date column found.")

def _find_close_col(df: pd.DataFrame) -> str:
    candidates = ["Close", "Adj Close", "Close*", "Price", "Last", "Close/Last"]
    for c in df.columns:
        if c.strip() in candidates or c.strip().lower() in [x.lower() for x in candidates]:
            return c
    # Fallback: first numeric-like column that's not the date
    for c in df.columns:
        if c.lower() != "date":
            try:
                pd.to_numeric(df[c].astype(str).str.replace(",", ""), errors="raise")
                return c
            except Exception:
                pass
    raise ValueError("No price/close column found.")

def load_series(path: str, label: str) -> pd.DataFrame:
    if not os.path.exists(path):
        print(f"WARNING: File not found at {path}. Returning empty DataFrame for {label}.")
        return pd.DataFrame(columns=[label]).set_index(pd.to_datetime([])) 
        
    df = pd.read_csv(path)
    df.columns = [c.strip() for c in df.columns]
    dcol = _find_date_col(df)
    ccol = _find_close_col(df)
    df["Date"] = pd.to_datetime(df[dcol].astype(str).str.strip(), errors="coerce")
    df[label] = _clean_num(df[ccol])
    df = df[["Date", label]].dropna().sort_values("Date")
    df = df[df["Date"] >= START_DATE].set_index("Date")
    return df

def make_price_fig(
    gold: pd.DataFrame, 
    btc: pd.DataFrame, 
    yaxis_type: str = "Linear",
    visible_events: list = [] 
) -> go.Figure:
    
    joined = gold.join(btc, how="inner").dropna()
    if joined.empty:
        return go.Figure().update_layout(title="No overlapping Gold/BTC data")
        
    fig = make_subplots(specs=[[{"secondary_y": True}]])
    fig.add_trace(
        go.Scatter(
            x=joined.index, y=joined["Gold"],
            name="Gold (USD / oz)",
            mode="lines",
            line=dict(width=2, color="gold"),
            hovertemplate="<br>".join([
                "<b>Date: %{x|%b %Y}</b>",
                "Gold (USD / oz): $%{y:.2f}",
                "<extra></extra>"
            ])
        ),
        secondary_y=False
    )
    fig.add_trace(
        go.Scatter(
            x=joined.index, y=joined["BTC"],
            name="Bitcoin (USD / BTC)",
            mode="lines",
            line=dict(width=2, color="navy"),
            hovertemplate="<br>".join([
                "<b>Date: %{x|%b %Y}</b>",
                "Bitcoin (USD / BTC): $%{y:.2f}",
                "<extra></extra>"
            ])
        ),
        secondary_y=True
    )

    axis_type_str = "log" if yaxis_type == "Log" else "linear"
    log_dtick = 1 if axis_type_str == "log" else None
    show_ticks = True #if axis_type_str == "linear" else False # Always show

    # --- Fixed Axis Ranging ---
    y1_min_data, y1_max_data = joined["Gold"].min(), joined["Gold"].max()
    y2_min_data, y2_max_data = joined["BTC"].min(), joined["BTC"].max()
    y1_pad = (y1_max_data - y1_min_data) * 0.05
    y2_pad = (y2_max_data - y2_min_data) * 0.05
    y1_range_linear = [y1_min_data - y1_pad, y1_max_data + y1_pad]
    y2_range_linear = [y2_min_data - y2_pad, y2_max_data + y2_pad]
    y1_min_log = max(y1_min_data * 0.95, 1) 
    y2_min_log = max(y2_min_data * 0.95, 1) 
    y1_range_log = [math.log10(y1_min_log), math.log10(y1_max_data * 1.05)]
    y2_range_log = [math.log10(y2_min_log), math.log10(y2_max_data * 1.05)]
    y1_range = y1_range_log if axis_type_str == "log" else y1_range_linear
    y2_range = y2_range_log if axis_type_str == "log" else y2_range_linear
    # ---------------------------------

    fig.update_layout(
        title="Gold & Bitcoin Growth",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=24) # --- MODIFIED: Font size ---
        ),
        plot_bgcolor='white',
    )

    fig.update_xaxes(
        title_text="Date", 
        title_font=dict(size=22), # --- MODIFIED: Font size ---
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=20) # --- MODIFIED: Font size ---
    )
    fig.update_yaxes(
        title_text="Gold (USD / oz)", 
        title_font=dict(size=26, color="gold"), # --- MODIFIED: Font size ---
        secondary_y=False, 
        showgrid=False,
        linecolor='black',
        mirror=True,
        type=axis_type_str,
        dtick=log_dtick,
        tickfont=dict(size=22), # --- MODIFIED: Font size ---
        showticklabels=show_ticks,
        range=y1_range 
    )
    fig.update_yaxes(
        title_text="Bitcoin (USD / BTC)", 
        title_font=dict(size=26, color="navy"), # --- MODIFIED: Font size ---
        secondary_y=True, 
        showgrid=False,
        linecolor='black',
        mirror=True,
        type=axis_type_str,
        dtick=log_dtick,
        tickfont=dict(size=22), # --- MODIFIED: Font size ---
        showticklabels=show_ticks,
        range=y2_range 
    )
    
    # --- ADD EVENTS (from checklist) ---
    for event_name in visible_events:
        if event_name in EVENTS_TO_PLOT:
            event_date = EVENTS_TO_PLOT[event_name]
            try:
                fig.add_vline(
                    x=pd.to_datetime(event_date),
                    line_width=1,
                    line_dash="dot",
                    line_color="black"
                )
                fig.add_annotation(
                    x=pd.to_datetime(event_date),
                    y=0.95, 
                    yref="paper",
                    text=event_name,
                    showarrow=False,
                    font=dict(size=18, color="black"), # --- MODIFIED: Font size ---
                    bgcolor="rgba(255, 255, 255, 0.7)",
                    bordercolor="black",
                    borderwidth=1,
                    xanchor="center",
                    yanchor="bottom"
                )
            except Exception as e:
                print(f"Could not plot event '{event_name}' at '{event_date}': {e}")
            
    return fig

# --- Correlation Figure Function ---
def make_corr_fig(gold: pd.DataFrame, btc: pd.DataFrame, sp: pd.DataFrame, window: int) -> go.Figure:
    ret_gold = gold['Gold'].pct_change().rename('Gold')
    ret_btc = btc['BTC'].pct_change().rename('BTC')
    ret_sp = sp['SP'].pct_change().rename('SP')
    ret = pd.concat([ret_gold, ret_btc, ret_sp], axis=1).dropna()
    
    if ret.empty:
        return go.Figure().update_layout(title="No overlapping data for correlations")

    corr_gold_sp = ret["Gold"].rolling(window).corr(ret["SP"])
    corr_btc_sp = ret["BTC"].rolling(window).corr(ret["SP"])

    fig = go.Figure()
    fig.add_trace(go.Scatter(
        x=corr_gold_sp.index, y=corr_gold_sp, 
        mode="lines",
        name=f"{window}-Day Gold vs S&P",
        line=dict(width=2, color="gold"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "Gold vs S&P Corr: %{y:.2f}",
            "<extra></extra>"
        ])
    ))
    fig.add_trace(go.Scatter(
        x=corr_btc_sp.index, y=corr_btc_sp, 
        mode="lines",
        name=f"{window}-Day BTC vs S&P",
        line=dict(width=2, color="navy"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "BTC vs S&P Corr: %{y:.2f}",
            "<extra></extra>"
        ])
    ))

    fig.add_hline(y=0, line_dash="dot", line_color="black")

    fig.update_layout(
        title=f"Rolling Correlations vs S&P 500",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        yaxis=dict(range=[-1, 1]),
        plot_bgcolor='white',
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=24) # --- MODIFIED: Font size ---
        )
    )
    
    fig.update_xaxes(
        title_text="Date", 
        title_font=dict(size=22), # --- MODIFIED: Font size ---
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=20) # --- MODIFIED: Font size ---
    )
    fig.update_yaxes(
        title_text="Correlation (ρ)", 
        title_font=dict(size=24), # --- MODIFIED: Font size ---
        showgrid=False,
        linecolor='black',
        mirror=True,
        tickfont=dict(size=20) # --- MODIFIED: Font size ---
    )
    return fig

# --- Volatility Figure Function ---
def make_vol_fig(gold: pd.DataFrame, btc: pd.DataFrame, window: int) -> go.Figure:
    ret_gold = gold['Gold'].pct_change().rename('Gold')
    ret_btc = btc['BTC'].pct_change().rename('BTC')
    ret = pd.concat([ret_gold, ret_btc], axis=1).dropna()
    
    if ret.empty:
        return go.Figure().update_layout(title="No overlapping data for Volatility")

    vol_gold = ret["Gold"].rolling(window).std() * np.sqrt(252)
    vol_btc = ret["BTC"].rolling(window).std() * np.sqrt(252)

    fig = go.Figure()
    fig.add_trace(go.Scatter(
        x=vol_gold.index, y=vol_gold, 
        mode="lines",
        name=f"{window}-Day Volatility (Gold)",
        line=dict(width=2, color="gold"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "Gold Volatility: %{y:.2%}", 
            "<extra></extra>"
        ])
    ))
    fig.add_trace(go.Scatter(
        x=vol_btc.index, y=vol_btc, 
        mode="lines",
        name=f"{window}-Day Volatility (BTC)",
        line=dict(width=2, color="navy"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "BTC Volatility: %{y:.2%}", 
            "<extra></extra>"
        ])
    ))

    fig.update_layout(
        title=f"{window}-Day Rolling Volatility (Annualised)",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        yaxis=dict(tickformat=".0%"), 
        plot_bgcolor='white',
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=24) # --- MODIFIED: Font size ---
        )
    )
    
    fig.update_xaxes(
        title_text="Date", 
        title_font=dict(size=22), # --- MODIFIED: Font size ---
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=20) # --- MODIFIED: Font size ---
    )
    fig.update_yaxes(
        title_text="Volatility (Annualised)", 
        title_font=dict(size=24), # --- MODIFIED: Font size ---
        showgrid=False,
        linecolor='black',
        mirror=True,
        tickfont=dict(size=20) # --- MODIFIED: Font size ---
    )
    return fig


