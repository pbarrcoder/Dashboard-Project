        ]
    ),

    html.Div(
        id="modal-project",
        style=modal_hidden_style, 
        children=[
            html.Div(style=modal_content_wrapper_style, children=[
                html.Div(style=modal_content_style, children=[
                    html.H3("Dashboard Overview", style=modal_header_style),
                    html.P("This dashboard analyses the relationship between Gold and Bitcoin, comparing their price growth, rolling volatility and correlation to the market."),
                    html.P("Use the tabs to explore different metrics:"),
                    html.Ul([
                        html.Li([
    html.Strong("Growth -  "),
    "Compare price charts on a linear or log scale, toggle major macro shocks and find price of each asset on any given day."
]),
html.Li([
    html.Strong("Correlation -  "),
    "Analyse how the assets move relative to the stock market (S&P 500) over time."
]),
html.Li([
    html.Strong("Volatility - "),
    "Analyse the (annualised) risk profile of each asset."
])
                    ]),
                    html.Button("Close", id="close-modal-project", style=modal_close_btn_style)
                ])
            ])
        ]
    ),
    
    dcc.Store(id="noop") 
])

# --- Callback for Price Graph (now with Events) ---
@app.callback(
    Output("fig-prices", "figure"),
    Input("price-axis-toggle", "value"),
    Input("event-checklist", "value") 
)
def update_price_fig_callback(yaxis_type, selected_events):
    return make_price_fig(gold, btc, yaxis_type, selected_events)

# --- Callback for Correlation Graph ---
@app.callback(
    Output("fig-corr", "figure"),
    Output("corr-title", "children"),
    Input("corr-slider", "value")
)
def update_corr_fig_callback(window_size):
    fig = make_corr_fig(gold, btc, sp, window_size)
    title = f"{window_size}-Day Rolling Correlations Vs S&P 500"
    return fig, title

# --- Callback for Volatility Graph ---
@app.callback(
    Output("fig-vol", "figure"),
    Output("vol-title", "children"),
    Input("vol-slider", "value")
)
def update_vol_fig_callback(window_size):
    fig = make_vol_fig(gold, btc, window_size)
    title = f"{window_size}-Day Rolling Volatility (Annualised)"
    return fig, title

# --- Callbacks for Modals (toggle style) ---
@app.callback(
    Output("modal-gold", "style"),
    Input("logo-gold", "n_clicks"),
    Input("close-modal-gold", "n_clicks"),
    State("modal-gold", "style"),
    prevent_initial_call=True
)
def toggle_modal_gold(n_open, n_close, current_style):
    if current_style and current_style.get('display') == 'none':
        return modal_visible_style 
    else:
        return modal_hidden_style 

@app.callback(
    Output("modal-btc", "style"),
    Input("logo-btc", "n_clicks"),
    Input("close-modal-btc", "n_clicks"),
    State("modal-btc", "style"),
    prevent_initial_call=True
)
def toggle_modal_btc(n_open, n_close, current_style):
    if current_style and current_style.get('display') == 'none':
        return modal_visible_style 
    else:
        return modal_hidden_style 

# --- NEW Callback for Project Modal ---
@app.callback(
    Output("modal-project", "style"),
    Input("logo-project", "n_clicks"),
    Input("close-modal-project", "n_clicks"),
    State("modal-project", "style"),
    prevent_initial_call=True
)
def toggle_modal_project(n_open, n_close, current_style):
    if current_style and current_style.get('display') == 'none':
        return modal_visible_style 
    else:
        return modal_hidden_style 
