# ---------- Helpers ----------
def _clean_num(s: pd.Series) -> pd.Series:
    # Remove quotes/commas/unicode minus; coerce to float
    return (
        s.astype(str)
        .str.replace('"', '', regex=False)
        .str.replace("'", "", regex=False)
        .str.replace(",", "", regex=False)
        .str.replace("\u2212", "-", regex=False)  # unicode minus to hyphen
        .str.strip()
        .replace({"": np.nan, "None": np.nan})
        .astype(float)
    )

def _find_date_col(df: pd.DataFrame) -> str:
    for c in df.columns:
        lc = c.strip().lower()
        if lc in ("date", "time", "day") or "date" in lc:
            return c
    raise ValueError("No date column found.")

def _find_close_col(df: pd.DataFrame) -> str:
    candidates = ["Close", "Adj Close", "Close*", "Price", "Last", "Close/Last"]
    for c in df.columns:
        if c.strip() in candidates or c.strip().lower() in [x.lower() for x in candidates]:
            return c
    # Fallback: first numeric-like column that's not the date
    for c in df.columns:
        if c.lower() != "date":
            try:
                pd.to_numeric(df[c].astype(str).str.replace(",", ""), errors="raise")
                return c
            except Exception:
                pass
    raise ValueError("No price/close column found.")

def load_series(path: str, label: str) -> pd.DataFrame:
    if not os.path.exists(path):
        print(f"WARNING: File not found at {path}. Returning empty DataFrame for {label}.")
        return pd.DataFrame(columns=[label]).set_index(pd.to_datetime([])) # empty datetime index
        
    df = pd.read_csv(path)
    df.columns = [c.strip() for c in df.columns]
    dcol = _find_date_col(df)
    ccol = _find_close_col(df)
    df["Date"] = pd.to_datetime(df[dcol].astype(str).str.strip(), errors="coerce")
    df[label] = _clean_num(df[ccol])
    df = df[["Date", label]].dropna().sort_values("Date")
    df = df[df["Date"] >= START_DATE].set_index("Date")
    return df

# ---------- Figures ----------
def make_price_fig(
    gold: pd.DataFrame, 
    btc: pd.DataFrame, 
    yaxis_type: str = "Linear",
    visible_events: list = [] # NEW: Accept list of events to show
) -> go.Figure:
    
    joined = gold.join(btc, how="inner").dropna()
    if joined.empty:
        return go.Figure().update_layout(title="No overlapping Gold/BTC data")
        
    fig = make_subplots(specs=[[{"secondary_y": True}]])
    fig.add_trace(
        go.Scatter(
            x=joined.index, y=joined["Gold"],
            name="Gold (USD / oz)",
            mode="lines",
            line=dict(width=2, color="gold"),
            hovertemplate="<br>".join([
                "<b>Date: %{x|%b %Y}</b>",
                "Gold (USD / oz): $%{y:.2f}",
                "<extra></extra>"
            ])
        ),
        secondary_y=False
    )
    fig.add_trace(
        go.Scatter(
            x=joined.index, y=joined["BTC"],
            name="Bitcoin (USD / BTC)",
            mode="lines",
            line=dict(width=2, color="navy"),
            hovertemplate="<br>".join([
                "<b>Date: %{x|%b %Y}</b>",
                "Bitcoin (USD / BTC): $%{y:.2f}",
                "<extra></extra>"
            ])
        ),
        secondary_y=True
    )

    axis_type_str = "log" if yaxis_type == "Log" else "linear"
    log_dtick = 1 if axis_type_str == "log" else None
    show_ticks = True #if axis_type_str == "linear" else False # Always show

    # --- Fixed Axis Ranging ---
    # Pre-calculate ranges based *only* on data to prevent annotations from shifting axes
    y1_min_data, y1_max_data = joined["Gold"].min(), joined["Gold"].max()
    y2_min_data, y2_max_data = joined["BTC"].min(), joined["BTC"].max()

    # Add a small padding (e.g., 5% to top/bottom)
    y1_pad = (y1_max_data - y1_min_data) * 0.05
    y2_pad = (y2_max_data - y2_min_data) * 0.05
    
    # Define ranges for linear scale
    y1_range_linear = [y1_min_data - y1_pad, y1_max_data + y1_pad]
    y2_range_linear = [y2_min_data - y2_pad, y2_max_data + y2_pad]

    # Define ranges for log scale
    # Ensure min > 0 for log
    y1_min_log = max(y1_min_data * 0.95, 1) # 5% buffer, min 1
    y2_min_log = max(y2_min_data * 0.95, 1) # 5% buffer, min 1
    y1_range_log = [math.log10(y1_min_log), math.log10(y1_max_data * 1.05)]
    y2_range_log = [math.log10(y2_min_log), math.log10(y2_max_data * 1.05)]
    
    # Select the range based on axis type
    y1_range = y1_range_log if axis_type_str == "log" else y1_range_linear
    y2_range = y2_range_log if axis_type_str == "log" else y2_range_linear
    # ---------------------------------

    fig.update_layout(
        title="Gold Vs Bitcoin Growth",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=16) # Larger legend
        ),
        plot_bgcolor='white',
    )

    fig.update_xaxes(
        title_text="Date", 
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=12)
    )
    fig.update_yaxes(
        title_text="Gold (USD / oz)", 
        title_font=dict(size=18, color="gold"), # Larger title, colored
        secondary_y=False, 
        showgrid=False,
        linecolor='black',
        mirror=True,
        type=axis_type_str,
        dtick=log_dtick,
        tickfont=dict(size=14), # Larger ticks
        showticklabels=show_ticks,
        range=y1_range # <-- APPLY FIXED RANGE
    )
    fig.update_yaxes(
        title_text="Bitcoin (USD / BTC)", 
        title_font=dict(size=18, color="navy"), # Larger title, colored
        secondary_y=True, 
        showgrid=False,
        linecolor='black',
        mirror=True,
        type=axis_type_str,
        dtick=log_dtick,
        tickfont=dict(size=14), # Larger ticks
        showticklabels=show_ticks,
        range=y2_range # <-- APPLY FIXED RANGE
    )
    
    # --- ADD EVENTS (from checklist) ---
    for event_name in visible_events:
        if event_name in EVENTS_TO_PLOT:
            event_date = EVENTS_TO_PLOT[event_name]
            try:
                fig.add_vline(
                    x=pd.to_datetime(event_date),
                    line_width=1,
                    line_dash="dot",
                    line_color="black"
                )
                fig.add_annotation(
                    x=pd.to_datetime(event_date),
                    y=0.95, # Position inside graph
                    yref="paper",
                    text=event_name,
                    showarrow=False,
                    font=dict(size=10, color="black"),
                    bgcolor="rgba(255, 255, 255, 0.7)",
                    bordercolor="black",
                    borderwidth=1,
                    xanchor="center",
                    yanchor="bottom"
                )
            except Exception as e:
                print(f"Could not plot event '{event_name}' at '{event_date}': {e}")
            
    return fig

# --- Correlation Figure Function ---
def make_corr_fig(gold: pd.DataFrame, btc: pd.DataFrame, sp: pd.DataFrame, window: int) -> go.Figure:
    # Calculate daily returns for each asset
    ret_gold = gold['Gold'].pct_change().rename('Gold')
    ret_btc = btc['BTC'].pct_change().rename('BTC')
    ret_sp = sp['SP'].pct_change().rename('SP')

    # Join all returns, keeping only dates where all three traded
    ret = pd.concat([ret_gold, ret_btc, ret_sp], axis=1).dropna()
    
    if ret.empty:
        print("="*50)
        print("CORRELATION DEBUG: No overlapping data found for Gold, BTC, and S&P after calculating returns.")
        print(f"Check if '{os.path.basename(SP_FILE)}' exists and has data after {START_DATE}.")
        print(f"Gold returns (non-NA): {len(ret_gold.dropna())}, BTC returns (non-NA): {len(ret_btc.dropna())}, S&P returns (non-NA): {len(ret_sp.dropna())}")
        print("="*50)
        return go.Figure().update_layout(title="No overlapping data for correlations (Check S&P file and dates)")

    # Calculate rolling correlations vs S&P 500
    corr_gold_sp = ret["Gold"].rolling(window).corr(ret["SP"])
    corr_btc_sp = ret["BTC"].rolling(window).corr(ret["SP"])

    fig = go.Figure()

    # Add Gold vs S&P line (Gold)
    fig.add_trace(go.Scatter(
        x=corr_gold_sp.index, y=corr_gold_sp, 
        mode="lines",
        name=f"{window}-Day Gold vs S&P",
        line=dict(width=2, color="gold"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "Gold vs S&P Corr: %{y:.2f}",
            "<extra></extra>"
        ])
    ))
    
    # Add BTC vs S&P line (Navy)
    fig.add_trace(go.Scatter(
        x=corr_btc_sp.index, y=corr_btc_sp, 
        mode="lines",
        name=f"{window}-Day BTC vs S&P",
        line=dict(width=2, color="navy"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "BTC vs S&P Corr: %{y:.2f}",
            "<extra></extra>"
        ])
    ))

    # Dotted zero line
    fig.add_hline(y=0, line_dash="dot", line_color="black")

    fig.update_layout(
        title=f"Rolling Correlations vs. S&P 500",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        yaxis=dict(range=[-1, 1]),
        plot_bgcolor='white',
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=16) # Match top graph legend
        )
    )
    
    fig.update_xaxes(
        title_text="Date", 
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=12)
    )
    fig.update_yaxes(
        title_text="Correlation (ρ)", 
        title_font=dict(size=16), 
        showgrid=False,
        linecolor='black',
        mirror=True,
        tickfont=dict(size=12)
    )
    return fig

# --- NEW: Volatility Figure Function ---
def make_vol_fig(gold: pd.DataFrame, btc: pd.DataFrame, window: int) -> go.Figure:
    # Calculate daily returns for each asset
    ret_gold = gold['Gold'].pct_change().rename('Gold')
    ret_btc = btc['BTC'].pct_change().rename('BTC')

    # Join returns
    ret = pd.concat([ret_gold, ret_btc], axis=1).dropna()
    
    if ret.empty:
        return go.Figure().update_layout(title="No overlapping data for Volatility")

    # Calculate rolling volatility (std dev of daily returns) and annualize it
    vol_gold = ret["Gold"].rolling(window).std() * np.sqrt(252)
    vol_btc = ret["BTC"].rolling(window).std() * np.sqrt(252)

    fig = go.Figure()

    # Add Gold Volatility line (Gold)
    fig.add_trace(go.Scatter(
        x=vol_gold.index, y=vol_gold, 
        mode="lines",
        name=f"{window}-Day Volatility (Gold)",
        line=dict(width=2, color="gold"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "Gold Volatility: %{y:.2%}", # Format as percentage
            "<extra></extra>"
        ])
    ))
    
    # Add BTC Volatility line (Navy)
    fig.add_trace(go.Scatter(
        x=vol_btc.index, y=vol_btc, 
        mode="lines",
        name=f"{window}-Day Volatility (BTC)",
        line=dict(width=2, color="navy"),
        hovertemplate="<br>".join([
            "<b>Date: %{x|%b %Y}</b>",
            "BTC Volatility: %{y:.2%}", # Format as percentage
            "<extra></extra>"
        ])
    ))

    fig.update_layout(
        title=f"{window}-Day Rolling Volatility (Annualized)",
        hovermode="x unified",
        margin=dict(l=40, r=40, t=50, b=80),
        yaxis=dict(tickformat=".0%"), # Format Y-axis as percentage
        plot_bgcolor='white',
        legend=dict(
            orientation="h",
            yanchor="top",
            y=-0.25,
            xanchor="left",
            x=0,
            font=dict(size=16) # Match other graphs
        )
    )
    
    fig.update_xaxes(
        title_text="Date", 
        showgrid=False, 
        linecolor='black', 
        mirror=True,
        tickfont=dict(size=12)
    )
    fig.update_yaxes(
        title_text="Volatility (Annualized)", 
        title_font=dict(size=16), 
        showgrid=False,
        linecolor='black',
        mirror=True,
        tickfont=dict(size=12)
    )
    return fig


